# --- Required ---
# Postgres connection string. On Railway, set this to a reference to your
# Postgres plugin's variable:  ${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgresql://user:password@localhost:5432/synapse_crm

# Secret used to sign login session tokens (JWT). Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional ---
# Port the server listens on. Railway sets this automatically.
PORT=3000

# Set to "true" only if your Postgres requires SSL (most managed providers do
# for EXTERNAL connections). Railway's internal connection does NOT need it.
DATABASE_SSL=false

# Comma-separated list of emails allowed to self-register. Leave blank to allow
# anyone with the URL to create an account. Example: alice@ifm.gov,bob@ifm.gov
ALLOWED_EMAILS=
